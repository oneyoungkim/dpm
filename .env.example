# 관심사 UI 검증용 예시 이벤트. 기본은 꺼짐이고, 로컬에서 볼 때만 1로 켠다.
# 배포 환경에서는 절대 켜지 않는다 — 실제로 열리지 않는 경기가 MAIN EVENT에 올라간다.
MATCHDAY_PREVIEW_EVENTS=0

# 공식 뉴스룸 RSS에서 미래 이벤트를 구조화할 때만 사용한다.
# 키가 없으면 candidates.json을 그대로 보존하고 이 단계만 건너뛴다.
OPENAI_API_KEY=
OPENAI_EVENT_MODEL=gpt-5.4-nano-2026-03-17
DISCOVERY_FORWARD_DAYS=550
DISCOVERY_FEED_LIMIT=8
DISCOVERY_WEB_SEARCH=1
