# 관심사 UI 검증용 예시 이벤트. 기본은 꺼짐이고, 로컬에서 볼 때만 1로 켠다.
# 배포 환경에서는 절대 켜지 않는다 — 실제로 열리지 않는 경기가 MAIN EVENT에 올라간다.
MATCHDAY_PREVIEW_EVENTS=0

# 공식 뉴스룸 RSS에서 미래 이벤트를 구조화할 때만 사용한다.
# 키가 없으면 candidates.json을 그대로 보존하고 이 단계만 건너뛴다.
OPENAI_API_KEY=
OPENAI_EVENT_MODEL=gpt-5.4-nano-2026-03-17
DISCOVERY_FORWARD_DAYS=550
DISCOVERY_FEED_LIMIT=8
DISCOVERY_WEB_SEARCH=1

# ── 사이트 ──────────────────────────────────────────────
# 도메인을 연결하면 바꾼다(끝에 슬래시 없이). 사이트맵·RSS·공유 이미지 주소가 이 값을 따른다.
NEXT_PUBLIC_SITE_URL=https://gak.gg
# 소개·개인정보 페이지에 공개되는 문의 메일. 비우면 "준비 중"으로 나온다.
NEXT_PUBLIC_CONTACT_EMAIL=
# 검색 등록 확인 코드
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_NAVER_VERIFICATION=
# 네이버·빙 빠른 색인(IndexNow) 키. 영문·숫자·하이픈 8~128자(예: openssl rand -hex 16).
# 비우면 /indexnow-key.txt 는 404이고 npm run seo:indexnow 는 안내만 하고 건너뛴다.
INDEXNOW_KEY=

# ── 광고(애드센스) ──────────────────────────────────────
# 게시자 ID가 비어 있으면 광고 코드와 /ads.txt 를 아예 싣지 않는다.
NEXT_PUBLIC_ADSENSE_CLIENT=
# 자리별 광고 단위 번호. 번호가 없는 자리는 그리지 않는다.
NEXT_PUBLIC_AD_SLOT_HOME_TOP=
NEXT_PUBLIC_AD_SLOT_HOME_MID=
NEXT_PUBLIC_AD_SLOT_RANK_MID=
NEXT_PUBLIC_AD_SLOT_ARTICLE_MID=
NEXT_PUBLIC_AD_SLOT_ARTICLE_END=
NEXT_PUBLIC_AD_SLOT_ARTICLE_RAIL=
NEXT_PUBLIC_AD_SLOT_LIST_MID=

# ── 키워드 순위 ────────────────────────────────────────
# 제목에 키워드를 붙이는 모델. 비우면 OPENAI_EVENT_MODEL 과 같은 값을 쓴다.
OPENAI_TREND_MODEL=

# ── 매거진 ─────────────────────────────────────────────
# 로컬에서 초안(draft: true)까지 보고 싶을 때만 1.
MAGAZINE_SHOW_DRAFTS=0
